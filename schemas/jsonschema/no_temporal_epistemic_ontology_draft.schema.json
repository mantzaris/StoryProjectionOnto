    "NoTemporalEpistemicAssertion": {
      "additionalProperties": false,
      "description": "Unqualified assertion emitted by ``A-NoTemporalEpistemic``.\n\nTemporal scope, proposition-content linkage, epistemic scope, and narrative\ncommitment are intentionally not fields of this model.  This makes the ablation\na real removal from constrained decoding rather than a prompt-only suggestion.",
      "properties": {
        "assertion_id": {
          "maxLength": 192,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:/-]*$",
          "title": "Assertion Id",
          "type": "string"
        },
        "confidence": {
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Confidence",
          "type": "number"
        },
        "content_hash": {
          "default": "",
          "pattern": "^(?:|[0-9a-f]{64})$",
          "title": "Content Hash",
          "type": "string"
        },
        "contextual_relevance": {
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Contextual Relevance",
          "type": "number"
        },
        "direction": {
          "default": "forward",
          "enum": [
            "forward",
            "inverse"
          ],
          "title": "Direction",
          "type": "string"
        },
        "evidence_ids": {
          "items": {
            "maxLength": 192,
            "minLength": 1,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:/-]*$",
            "type": "string"
          },
          "title": "Evidence Ids",
          "type": "array"
        },
        "object_id": {
          "anyOf": [
            {
              "maxLength": 192,
              "minLength": 1,
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:/-]*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Object Id"
        },
        "predicate_id": {
          "maxLength": 192,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:/-]*$",
          "title": "Predicate Id",
          "type": "string"
        },
        "provenance": {
          "items": {
            "$ref": "#/$defs/ProvenanceReference"
          },
          "title": "Provenance",
          "type": "array"
        },
        "roles": {
          "default": [],
          "items": {
            "$ref": "#/$defs/RoleBinding"
          },
          "title": "Roles",
          "type": "array"
        },
        "schema_version": {
          "const": "1.0.0",
          "default": "1.0.0",
          "title": "Schema Version",
          "type": "string"
        },
        "subject_id": {
          "anyOf": [
            {
              "maxLength": 192,
              "minLength": 1,
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:/-]*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Subject Id"
        },
        "why_matters": {
          "minLength": 1,
          "title": "Why Matters",
          "type": "string"
        },
        "why_matters_evidence_ids": {
          "items": {
            "maxLength": 192,
            "minLength": 1,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:/-]*$",
            "type": "string"
