      "enum": [
        "before",
        "after",
        "meets",
        "met_by",
        "overlaps",
        "overlapped_by",
        "starts",
        "started_by",
        "during",
        "contains",
        "finishes",
        "finished_by",
        "equals"
      ],
      "title": "AllenRelation",
      "type": "string"
    },
    "DiscoursePosition": {
      "additionalProperties": false,
      "properties": {
        "content_hash": {
          "default": "",
