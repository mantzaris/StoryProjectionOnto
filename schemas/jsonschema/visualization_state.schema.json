          "title": "Content Hash",
          "type": "string"
        },
        "passage_order": {
          "minimum": 0,
          "title": "Passage Order",
          "type": "integer"
        },
        "schema_version": {
          "const": "1.0.0",
          "default": "1.0.0",
          "title": "Schema Version",
          "type": "string"
        },
        "sentence_order": {
          "default": 0,
          "minimum": 0,
          "title": "Sentence Order",
          "type": "integer"
        },
        "token_order": {
          "default": 0,
          "minimum": 0,
          "title": "Token Order",
          "type": "integer"
        }
      },
      "required": [
        "passage_order"
      ],
      "title": "DiscoursePosition",
      "type": "object"
