{
  "$defs": {
    "FallbackV4AbsenceInventory": {
      "additionalProperties": false,
      "properties": {
        "absent_basenames": {
          "items": {
            "maxLength": 255,
            "minLength": 1,
            "pattern": "^[A-Za-z0-9.][A-Za-z0-9._-]*$",
            "type": "string"
          },
          "title": "Absent Basenames",
          "type": "array"
        },
        "all_required_paths_absent": {
          "const": true,
          "title": "All Required Paths Absent",
          "type": "boolean"
        },
        "guardian_ready_receipt_count": {
          "const": 0,
          "title": "Guardian Ready Receipt Count",
          "type": "integer"
        },
        "internal_controller_receipt_count": {
          "const": 0,
          "title": "Internal Controller Receipt Count",
          "type": "integer"
        },
        "observed_run_root_basenames": {
          "items": {
            "maxLength": 255,
            "minLength": 1,
            "pattern": "^[A-Za-z0-9.][A-Za-z0-9._-]*$",
            "type": "string"
          },
          "title": "Observed Run Root Basenames",
          "type": "array"
        }
      },
      "required": [
        "observed_run_root_basenames",
        "absent_basenames",
        "guardian_ready_receipt_count",
        "internal_controller_receipt_count",
        "all_required_paths_absent"
      ],
      "title": "FallbackV4AbsenceInventory",
      "type": "object"
    },
    "FallbackV4Accounting": {
      "additionalProperties": false,
      "properties": {
        "after": {
          "$ref": "#/$defs/FallbackV4LedgerBinding"
        },
        "before": {
          "$ref": "#/$defs/FallbackV4LedgerBinding"
        },
        "delta": {
          "$ref": "#/$defs/FallbackV4ZeroDelta"
        }
      },
      "required": [
        "before",
        "after",
        "delta"
      ],
      "title": "FallbackV4Accounting",
      "type": "object"
    },
    "FallbackV4FailureClassification": {
      "additionalProperties": false,
      "properties": {
        "command_line_public": {
          "const": false,
          "title": "Command Line Public",
          "type": "boolean"
        },
        "failure_stage": {
          "const": "guardian_identity_validation_before_readiness",
          "title": "Failure Stage",
          "type": "string"
        },
        "full_log_text_public": {
          "const": false,
          "title": "Full Log Text Public",
          "type": "boolean"
        },
        "guardian_exception_type": {
          "const": "ValueError",
          "title": "Guardian Exception Type",
          "type": "string"
        },
        "outer_exception_type": {
          "const": "RuntimeError",
          "title": "Outer Exception Type",
          "type": "string"
        },
        "remote_absolute_paths_public": {
          "const": false,
          "title": "Remote Absolute Paths Public",
          "type": "boolean"
        },
        "safe_error_class": {
          "const": "guardian_outer_result_path_identity_mismatch_before_readiness",
          "title": "Safe Error Class",
          "type": "string"
        },
        "scientific_generation_reached": {
          "const": false,
          "title": "Scientific Generation Reached",
          "type": "boolean"
        }
      },
      "required": [
        "safe_error_class",
        "outer_exception_type",
        "guardian_exception_type",
        "failure_stage",
        "scientific_generation_reached",
        "full_log_text_public",
        "command_line_public",
        "remote_absolute_paths_public"
      ],
      "title": "FallbackV4FailureClassification",
      "type": "object"
    },
    "FallbackV4LedgerBinding": {
      "additionalProperties": false,
      "properties": {
        "basename": {
          "const": "phase1_acceptance.sqlite",
          "title": "Basename",
          "type": "string"
        },
        "file_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "File Sha256",
          "type": "string"
        },
        "size_bytes": {
          "exclusiveMinimum": 0,
          "title": "Size Bytes",
          "type": "integer"
        },
        "summary": {
          "$ref": "#/$defs/FallbackV4LedgerSummary"
        }
      },
      "required": [
        "basename",
        "size_bytes",
        "file_sha256",
        "summary"
      ],
      "title": "FallbackV4LedgerBinding",
      "type": "object"
    },
    "FallbackV4LedgerSummary": {
      "additionalProperties": false,
      "properties": {
        "artifact_count": {
          "minimum": 0,
          "title": "Artifact Count",
          "type": "integer"
        },
        "attempt_count": {
          "minimum": 0,
          "title": "Attempt Count",
          "type": "integer"
        },
        "by_kind_microseconds": {
          "additionalProperties": {
            "type": "integer"
          },
          "title": "By Kind Microseconds",
          "type": "object"
        },
        "event_count": {
          "minimum": 0,
          "title": "Event Count",
          "type": "integer"
        },
        "model_call_count": {
          "minimum": 0,
          "title": "Model Call Count",
          "type": "integer"
        },
        "service_session_count": {
          "minimum": 0,
          "title": "Service Session Count",
          "type": "integer"
        },
        "service_start_event_count": {
          "minimum": 0,
          "title": "Service Start Event Count",
          "type": "integer"
        },
        "total_allocated_microseconds": {
          "minimum": 0,
          "title": "Total Allocated Microseconds",
          "type": "integer"
        },
        "unresolved_gpu_allocation_count": {
          "minimum": 0,
          "title": "Unresolved Gpu Allocation Count",
          "type": "integer"
        },
        "unresolved_gpu_service_count": {
          "minimum": 0,
          "title": "Unresolved Gpu Service Count",
          "type": "integer"
        }
      },
      "required": [
        "total_allocated_microseconds",
        "event_count",
        "service_session_count",
        "service_start_event_count",
        "attempt_count",
        "model_call_count",
        "artifact_count",
        "unresolved_gpu_allocation_count",
        "unresolved_gpu_service_count",
        "by_kind_microseconds"
      ],
      "title": "FallbackV4LedgerSummary",
      "type": "object"
    },
    "FallbackV4OrchestrationIdentity": {
      "additionalProperties": false,
      "properties": {
        "execution_arguments_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Execution Arguments Sha256",
          "type": "string"
        },
        "guardian_command_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Guardian Command Sha256",
          "type": "string"
        },
        "guardian_ticket_manifest_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Guardian Ticket Manifest Sha256",
          "type": "string"
        },
        "orchestration_invocation_manifest_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Orchestration Invocation Manifest Sha256",
          "type": "string"
        },
        "orchestrator_command_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Orchestrator Command Sha256",
          "type": "string"
        },
        "orchestrator_guard_manifest_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Orchestrator Guard Manifest Sha256",
          "type": "string"
        },
        "service_event_id": {
          "const": "fallback-qwen3-8b-awq-development-v4-service-start-001",
          "title": "Service Event Id",
          "type": "string"
        },
        "service_session_id": {
          "const": "fallback-qwen3-8b-awq-development-v4",
          "title": "Service Session Id",
          "type": "string"
        }
      },
      "required": [
        "execution_arguments_sha256",
        "orchestration_invocation_manifest_sha256",
        "guardian_ticket_manifest_sha256",
        "orchestrator_guard_manifest_sha256",
        "guardian_command_sha256",
        "orchestrator_command_sha256",
        "service_session_id",
        "service_event_id"
      ],
      "title": "FallbackV4OrchestrationIdentity",
      "type": "object"
    },
    "FallbackV4RestrictedEvidence": {
      "additionalProperties": false,
      "properties": {
        "guardian_log": {
          "$ref": "#/$defs/OpaqueFileBinding"
        },
        "guardian_ticket": {
          "$ref": "#/$defs/SelfHashedFileBinding"
        },
        "orchestration_invocation": {
          "$ref": "#/$defs/SelfHashedFileBinding"
        },
        "orchestrator_guard": {
          "$ref": "#/$defs/SelfHashedFileBinding"
        },
        "orchestrator_log": {
          "$ref": "#/$defs/OpaqueFileBinding"
        },
        "post_failure_status": {
          "$ref": "#/$defs/SelfHashedFileBinding"
        },
        "run_root_inventory_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Run Root Inventory Sha256",
          "type": "string"
        }
      },
      "required": [
        "orchestration_invocation",
        "guardian_ticket",
        "orchestrator_guard",
        "post_failure_status",
        "guardian_log",
        "orchestrator_log",
        "run_root_inventory_sha256"
      ],
      "title": "FallbackV4RestrictedEvidence",
      "type": "object"
    },
    "FallbackV4SourceAndAuthorization": {
      "additionalProperties": false,
      "properties": {
        "authorization_overlay": {
          "$ref": "#/$defs/SelfHashedFileBinding"
        },
        "execution_preflight": {
          "$ref": "#/$defs/SelfHashedFileBinding"
        },
        "source_association": {
          "$ref": "#/$defs/SelfHashedFileBinding"
        },
        "source_git_commit": {
          "pattern": "^[0-9a-f]{40}$",
          "title": "Source Git Commit",
          "type": "string"
        },
        "source_revision": {
          "const": "fallback-second-recovery-v4",
          "title": "Source Revision",
          "type": "string"
        },
        "source_tree_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Source Tree Sha256",
          "type": "string"
        }
      },
      "required": [
        "source_revision",
        "source_git_commit",
        "source_tree_sha256",
        "source_association",
        "authorization_overlay",
        "execution_preflight"
      ],
      "title": "FallbackV4SourceAndAuthorization",
      "type": "object"
    },
    "FallbackV4TerminalState": {
      "additionalProperties": false,
      "properties": {
        "accepted_output_count": {
          "const": 0,
          "title": "Accepted Output Count",
          "type": "integer"
        },
        "checkpoint_present": {
          "const": false,
          "title": "Checkpoint Present",
          "type": "boolean"
        },
        "cleanup_present": {
          "const": false,
          "title": "Cleanup Present",
          "type": "boolean"
        },
        "controller_handoff_present": {
          "const": false,
          "title": "Controller Handoff Present",
          "type": "boolean"
        },
        "fresh_source_bound_run_required": {
          "const": true,
          "title": "Fresh Source Bound Run Required",
          "type": "boolean"
        },
        "gpu_allocation_performed": {
          "const": false,
          "title": "Gpu Allocation Performed",
          "type": "boolean"
        },
        "guardian_exit_code": {
          "const": 1,
          "title": "Guardian Exit Code",
          "type": "integer"
        },
        "guardian_ready": {
          "const": false,
          "title": "Guardian Ready",
          "type": "boolean"
        },
        "guardian_terminal": {
          "const": false,
          "title": "Guardian Terminal",
          "type": "boolean"
        },
        "historical_status_resume_allowed": {
          "const": true,
          "title": "Historical Status Resume Allowed",
          "type": "boolean"
        },
        "inference_attempt_count": {
          "const": 0,
          "title": "Inference Attempt Count",
          "type": "integer"
        },
        "latest_control_group_live": {
          "const": false,
          "title": "Latest Control Group Live",
          "type": "boolean"
        },
        "latest_orchestrator_live": {
          "const": false,
          "title": "Latest Orchestrator Live",
          "type": "boolean"
        },
        "live_internal_controller_count": {
          "const": 0,
          "title": "Live Internal Controller Count",
          "type": "integer"
        },
        "model_process_started": {
          "const": false,
          "title": "Model Process Started",
          "type": "boolean"
        },
        "outer_exit_code": {
          "const": 1,
          "title": "Outer Exit Code",
          "type": "integer"
        },
        "public_result_present": {
          "const": false,
          "title": "Public Result Present",
          "type": "boolean"
        },
        "service_start_attempted": {
          "const": null,
          "title": "Service Start Attempted",
          "type": "null"
        },
        "source_bound_v4_resume_permitted": {
          "const": false,
          "title": "Source Bound V4 Resume Permitted",
          "type": "boolean"
        },
        "vllm_service_started": {
          "const": false,
          "title": "Vllm Service Started",
          "type": "boolean"
        }
      },
      "required": [
        "outer_exit_code",
        "guardian_exit_code",
        "guardian_ready",
        "guardian_terminal",
        "checkpoint_present",
        "controller_handoff_present",
        "cleanup_present",
        "public_result_present",
        "service_start_attempted",
        "model_process_started",
        "vllm_service_started",
        "gpu_allocation_performed",
        "inference_attempt_count",
        "accepted_output_count",
        "latest_orchestrator_live",
        "latest_control_group_live",
        "live_internal_controller_count",
        "historical_status_resume_allowed",
        "source_bound_v4_resume_permitted",
        "fresh_source_bound_run_required"
      ],
      "title": "FallbackV4TerminalState",
      "type": "object"
    },
    "FallbackV4ZeroDelta": {
      "additionalProperties": false,
      "properties": {
        "accepted_outputs": {
          "const": 0,
          "title": "Accepted Outputs",
          "type": "integer"
        },
        "allocated_gpu_microseconds": {
          "const": 0,
          "title": "Allocated Gpu Microseconds",
          "type": "integer"
        },
        "artifacts": {
          "const": 0,
          "title": "Artifacts",
          "type": "integer"
        },
        "attempts": {
          "const": 0,
          "title": "Attempts",
          "type": "integer"
        },
        "authorized_retry_inference_consumed": {
          "const": false,
          "title": "Authorized Retry Inference Consumed",
          "type": "boolean"
        },
        "authorized_service_start_consumed": {
          "const": false,
          "title": "Authorized Service Start Consumed",
          "type": "boolean"
        },
        "control_plane_launch_attempts": {
          "const": 1,
          "title": "Control Plane Launch Attempts",
          "type": "integer"
        },
        "gpu_events": {
          "const": 0,
          "title": "Gpu Events",
          "type": "integer"
        },
        "inference_model_calls": {
          "const": 0,
          "title": "Inference Model Calls",
          "type": "integer"
        },
        "service_sessions": {
          "const": 0,
          "title": "Service Sessions",
          "type": "integer"
        },
        "service_start_events": {
          "const": 0,
          "title": "Service Start Events",
          "type": "integer"
        },
        "unresolved_gpu_allocations": {
          "const": 0,
          "title": "Unresolved Gpu Allocations",
          "type": "integer"
        },
        "unresolved_gpu_services": {
          "const": 0,
          "title": "Unresolved Gpu Services",
          "type": "integer"
        }
      },
      "required": [
        "allocated_gpu_microseconds",
        "gpu_events",
        "service_sessions",
        "service_start_events",
        "attempts",
        "inference_model_calls",
        "artifacts",
        "unresolved_gpu_allocations",
        "unresolved_gpu_services",
        "accepted_outputs",
        "authorized_retry_inference_consumed",
        "authorized_service_start_consumed",
        "control_plane_launch_attempts"
      ],
      "title": "FallbackV4ZeroDelta",
      "type": "object"
    },
    "OpaqueFileBinding": {
      "additionalProperties": false,
      "description": "Safe public identity for one restricted non-JSON artifact.",
      "properties": {
        "basename": {
          "maxLength": 255,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9.][A-Za-z0-9._-]*$",
          "title": "Basename",
          "type": "string"
        },
        "file_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "File Sha256",
          "type": "string"
        },
        "size_bytes": {
          "exclusiveMinimum": 0,
          "title": "Size Bytes",
          "type": "integer"
        }
      },
      "required": [
        "basename",
        "size_bytes",
        "file_sha256"
      ],
      "title": "OpaqueFileBinding",
      "type": "object"
    },
    "SelfHashedFileBinding": {
      "additionalProperties": false,
      "description": "Safe public identity for one private or public self-hashed JSON file.",
      "properties": {
        "basename": {
          "maxLength": 255,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9.][A-Za-z0-9._-]*$",
          "title": "Basename",
          "type": "string"
        },
        "file_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "File Sha256",
          "type": "string"
        },
        "kind": {
          "maxLength": 255,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9.][A-Za-z0-9._-]*$",
          "title": "Kind",
          "type": "string"
        },
        "manifest_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Manifest Sha256",
          "type": "string"
        },
        "size_bytes": {
          "exclusiveMinimum": 0,
          "title": "Size Bytes",
          "type": "integer"
        }
      },
      "required": [
        "basename",
        "size_bytes",
        "file_sha256",
        "kind",
        "manifest_sha256"
      ],
      "title": "SelfHashedFileBinding",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "Self-hashed public description of the exact fallback-v4 incident.",
  "properties": {
    "absence_inventory": {
      "$ref": "#/$defs/FallbackV4AbsenceInventory"
    },
    "accounting": {
      "$ref": "#/$defs/FallbackV4Accounting"
    },
    "audited_at": {
      "format": "date-time",
      "title": "Audited At",
      "type": "string"
    },
    "failure": {
      "$ref": "#/$defs/FallbackV4FailureClassification"
    },
    "kind": {
      "const": "fallback_gpu_acceptance_control_plane_incident",
      "title": "Kind",
      "type": "string"
    },
    "manifest_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Manifest Sha256",
      "type": "string"
    },
    "orchestration_identity": {
      "$ref": "#/$defs/FallbackV4OrchestrationIdentity"
    },
    "restricted_evidence": {
      "$ref": "#/$defs/FallbackV4RestrictedEvidence"
    },
    "run_id": {
      "const": "fallback-qwen3-8b-awq-development-v4",
      "title": "Run Id",
      "type": "string"
    },
    "schema_version": {
      "const": "1.0.0",
      "default": "1.0.0",
      "title": "Schema Version",
      "type": "string"
    },
    "source_and_authorization": {
      "$ref": "#/$defs/FallbackV4SourceAndAuthorization"
    },
    "terminal_state": {
      "$ref": "#/$defs/FallbackV4TerminalState"
    }
  },
  "required": [
    "kind",
    "run_id",
    "audited_at",
    "source_and_authorization",
    "restricted_evidence",
    "orchestration_identity",
    "accounting",
    "absence_inventory",
    "terminal_state",
    "failure",
    "manifest_sha256"
  ],
  "title": "FallbackControlPlaneIncident",
  "type": "object"
}
