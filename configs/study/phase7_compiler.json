  "sections": [
    {"section_id": "research_questions", "title": "Research questions and hypotheses", "required_phases": ["phase_1"], "table_ids": [], "fixed_text": ["H1-semantic registers strict qualified-assertion F1 and H1-organization registers ontology-decision macro F1 for C2 versus C1. Rare-pivotal recall is a noncompensable safeguard, not another optimization target."]},
    {"section_id": "conditions", "title": "Experimental conditions and construction timing", "required_phases": ["phase_3"], "table_ids": [], "fixed_text": ["C0 and C1 construct before query reveal; C2 actively constructs after query reveal; A-FixedSelect uses query-time LLM selection over the complete sealed C1 ontology while construction operations are mechanically forbidden."]},
    {"section_id": "temporal_representation", "title": "Temporal qualified-assertion representation", "required_phases": ["phase_1"], "table_ids": [], "fixed_text": ["Assertions separate story time, validity time, discourse order, proposition revelation position, spoiler horizon, holder-level epistemic status, confidence, provenance, contextual relevance, and supported why-it-matters text."]},
    {"section_id": "synthetic_benchmark", "title": "Synthetic benchmark construction and split", "required_phases": ["phase_2"], "table_ids": [], "fixed_text": ["The registered design contains four development worlds and twelve held-out worlds with three same-evidence contexts per held-out world. Held-out execution remains gated on independent condition-blind review."]},
    {"section_id": "resource_controls", "title": "Resource and reproducibility controls", "required_phases": ["phase_1", "phase_7"], "table_ids": ["study_status", "resource_accounting"], "fixed_text": ["GPU time includes loading, warm-up, failures, repairs, restarts, and inference. Occupied project storage targets at most 25 GB with 5 GB protected headroom."]},
    {"section_id": "primary_results", "title": "Primary C2 versus C1 results", "required_phases": ["phase_3", "phase_4"], "table_ids": ["primary_c2_vs_c1"], "fixed_text": ["This confirmatory section will use twelve worlds as independent units, two one-sided paired t-tests, Holm correction, two-sided paired intervals, all 4096 sign-flip assignments, and the registered bootstrap sensitivity."]},
    {"section_id": "secondary_results", "title": "Required C2 versus C0 results", "required_phases": ["phase_3", "phase_4"], "table_ids": ["secondary_c2_vs_c0"], "fixed_text": ["C2 versus the credible deterministic C0 baseline is a required secondary comparison on all retained endpoints."]},
    {"section_id": "mechanism_results", "title": "Gated C2 versus A-FixedSelect mechanism results", "required_phases": ["phase_3", "phase_4"], "table_ids": ["mechanism_c2_vs_fixed"], "fixed_text": ["The mechanism claim is eligible only after the C2-versus-C1 organization gate passes and C2 exceeds mechanically construction-disabled A-FixedSelect on the registered endpoint."]},
    {"section_id": "rare_pivotal", "title": "Rare-pivotal preservation", "required_phases": ["phase_3", "phase_4"], "table_ids": ["rare_pivotal"], "fixed_text": ["Any favorable claim must accompany rare-pivotal qualified-assertion recall and support-path survival; the registered noninferiority loss margin is 0.05."]},
    {"section_id": "entropy_clutter", "title": "Entropy and visual-clutter profiles", "required_phases": ["phase_4", "phase_5"], "table_ids": ["entropy_clutter"], "fixed_text": ["No entropy direction, node count, crossing count, or cluster count is inherently better. Structural profiles must remain beside fidelity, grounding, validity, and rare-pivotal preservation."]},
    {"section_id": "community", "title": "Community and cluster organization", "required_phases": ["phase_4"], "table_ids": ["community"], "fixed_text": ["The registered panel uses Leiden-CPM with AMI, purity, conductance, fragmentation, merging error, descriptive cluster count and modularity, and cross-seed stability."]},
    {"section_id": "paraphrase_contrastive", "title": "Paraphrase and contrastive behavior", "required_phases": ["phase_3", "phase_4"], "table_ids": ["paraphrase_contrastive"], "fixed_text": ["Contrastive decision-change scoring operates over identical evidence and nonselection ontology changes. Paraphrase stability is interpreted conditional on correctness."]},
    {"section_id": "ablations", "title": "Reduced ablation results", "required_phases": ["phase_4"], "table_ids": ["ablations"], "fixed_text": ["Only A-NoContext (12 calls), A-NoTemporalEpistemic (8), and A-NoRareGuard (8) are registered, each with a one-switch-only configuration audit."]},
    {"section_id": "feedback_interface", "title": "Feedback and interface demonstrations", "required_phases": ["phase_5"], "table_ids": ["feedback"], "fixed_text": ["Six known-answer scripts and three researcher traces demonstrate REFINE_CONTEXT and REQUEST_MERGE_SPLIT. They do not support participant or usability claims."]},
    {"section_id": "novel_case", "title": "Bounded first-novel transfer study", "required_phases": ["phase_6"], "table_ids": ["novel_case"], "fixed_text": ["The planned transfer study uses four preregistered windows, eight bounded same-evidence queries, and one separately labeled full-index operational C2 query. Public examples must use paraphrases and opaque evidence IDs."]},
    {"section_id": "runtime_failures", "title": "Runtime, GPU, storage, invalid-output, repair, and failure accounting", "required_phases": ["phase_1", "phase_7"], "table_ids": ["failure_accounting"], "fixed_text": ["Failures and invalid or unrepaired outputs remain visible and intention-to-treat. Final accounting is cumulative across every registered base call, repair, failure, timeout, and GPU-service allocation."]},
    {"section_id": "error_limitations", "title": "Error analysis, negative results, and limitations", "required_phases": ["phase_3", "phase_4", "phase_6", "phase_7"], "table_ids": [], "fixed_text": ["The final analysis must retain null and negative findings, all declared error categories, the twelve-world sample limitation, one-model and one-prompt dependence, compute asymmetry, and descriptive-only transfer scope."]},
    {"section_id": "claim_boundaries", "title": "Exact claim boundaries", "required_phases": ["phase_7"], "table_ids": [], "fixed_text": ["Claims are conditional on registered gates and confined to the benchmark, pinned model, frozen prompt, and bounded narrative transfer study."]},
    {"section_id": "qualitative_examples", "title": "Easy-to-interpret qualitative illustrations", "required_phases": ["phase_2", "phase_3", "phase_5", "phase_6"], "table_ids": ["qualitative_examples"], "fixed_text": ["The final report reserves distinct slots for the development tutorial, rare-pivotal fact, temporal or epistemic case, fixed held-out illustration, deterministic failure case, and one or two narrative illustrations. These do not substitute for aggregate efficacy evidence."]}
  ],
